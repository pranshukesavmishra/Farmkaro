# NOTHING IN THIS FILE IS REQUIRED. The app runs fully keyless out of the box:
# real satellite imagery + place labels + roads (Esri), and place search
# (OpenStreetMap Nominatim). The settings below are optional upgrades.

# --- Basemap -----------------------------------------------------------------
# Satellite raster tiles. Default (unset) uses Esri World Imagery, no API key.
# NEXT_PUBLIC_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# For local development with no outbound network:
# NEXT_PUBLIC_SATELLITE_TILE_URL=/api/dev-tiles/{z}/{x}/{y}

# --- Optional providers ------------------------------------------------------
# Google Maps: set this to switch the discovery map to real Google satellite
# (Maps JavaScript API). Leave unset to use the keyless MapLibre + Esri map.
# Create a key at https://console.cloud.google.com/google/maps-apis, enable
# "Maps JavaScript API", and restrict it to your site's domain.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_MAPTILER_KEY=

# --- Database ----------------------------------------------------------------
# When set, the app is expected to use a PostGIS-backed repository instead of
# the in-memory sample dataset. See docs/07-data-model.sql.
# DATABASE_URL=postgresql://farmkaro:farmkaro@localhost:5432/farmkaro

# --- Hybrid overlays (optional) ----------------------------------------------
# Place labels and roads drawn over the satellite imagery, giving the same
# composition as Google's "hybrid" view. Defaults are keyless Esri layers.
# NEXT_PUBLIC_LABELS_TILE_URL=
# NEXT_PUBLIC_ROADS_TILE_URL=

# --- Place search (optional) --------------------------------------------------
# Default is OpenStreetMap Nominatim (keyless). Point this at a self-hosted
# Nominatim or a commercial geocoder for higher request volumes.
# NEXT_PUBLIC_GEOCODER_URL=https://nominatim.openstreetmap.org/search
