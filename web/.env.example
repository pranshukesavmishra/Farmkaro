# --- Basemap -----------------------------------------------------------------
# Satellite raster tiles. Default (unset) uses Esri World Imagery, no API key.
# NEXT_PUBLIC_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# For local development with no outbound network:
# NEXT_PUBLIC_SATELLITE_TILE_URL=/api/dev-tiles/{z}/{x}/{y}

# --- Optional providers ------------------------------------------------------
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# NEXT_PUBLIC_MAPTILER_KEY=

# --- Database ----------------------------------------------------------------
# When set, the app is expected to use a PostGIS-backed repository instead of
# the in-memory sample dataset. See docs/07-data-model.sql.
# DATABASE_URL=postgresql://farmkaro:farmkaro@localhost:5432/farmkaro
